import { db, nowISO } from './db';
import { ApiError } from './http';
import { getBookingRow, markBookingPaid, markBookingPaymentFailed, recordEvent } from './bookings';
import { paymentId as newPaymentId } from './references';
import type { PaymentMethod, PaymentProvider, PaymentRow, PaymentStatus } from './types';
import {
  chargeMobileMoney,
  createCardCheckout,
  FlutterwaveError,
  paymentsAreSandbox,
  type VerifiedTransaction,
} from './payments/flutterwave';

export interface StartPaymentResult {
  payment: PaymentRow;
  sandbox: boolean;
  checkoutUrl: string | null;
  pendingProvider: boolean;
  message: string;
}

export function paymentMode() {
  return paymentsAreSandbox() ? 'sandbox' : 'live';
}

export function getPaymentById(id: string) {
  return db.prepare('SELECT * FROM payments WHERE id = ?').get(id) as PaymentRow | undefined;
}

const getPayment = getPaymentById;

function updatePayment(
  id: string,
  values: Partial<Pick<PaymentRow, 'status' | 'provider_reference' | 'checkout_url' | 'failure_reason'>>
) {
  const fields: string[] = [];
  const params: Record<string, unknown> = { id, updated_at: nowISO() };

  for (const [key, value] of Object.entries(values)) {
    if (value !== undefined) {
      fields.push(`${key} = @${key}`);
      params[key] = value;
    }
  }

  fields.push('updated_at = @updated_at');
  db.prepare(`UPDATE payments SET ${fields.join(', ')} WHERE id = @id`).run(params);
}

export async function startPayment(
  reference: string,
  method: PaymentMethod,
  phone?: string
): Promise<StartPaymentResult> {
  const booking = getBookingRow(reference);
  if (!booking) throw new ApiError(404, 'Booking not found.', 'not_found');
  if (booking.status === 'cancelled') {
    throw new ApiError(409, 'This booking was cancelled.', 'booking_cancelled');
  }
  if (booking.payment_status === 'paid') {
    throw new ApiError(409, 'This booking is already paid.', 'already_paid');
  }
  if ((method === 'mtn' || method === 'airtel') && !(phone || booking.guest_phone)) {
    throw new ApiError(422, 'Enter the mobile money number that will pay.', 'phone_required');
  }

  const sandbox = paymentsAreSandbox();
  const provider: PaymentProvider = sandbox ? 'sandbox' : 'flutterwave';
  const id = newPaymentId();
  const timestamp = nowISO();

  db.transaction(() => {
    // Only one active payment attempt per booking.
    db.prepare(
      `UPDATE payments SET status = 'cancelled', updated_at = ?
       WHERE booking_reference = ? AND status IN ('pending', 'processing')`
    ).run(timestamp, booking.reference);

    db.prepare(
      `INSERT INTO payments (
        id, booking_reference, provider, method, amount, currency, status,
        payer_phone, created_at, updated_at
      ) VALUES (?, ?, ?, ?, ?, ?, 'pending', ?, ?, ?)`
    ).run(
      id,
      booking.reference,
      provider,
      method,
      booking.total,
      booking.currency,
      phone || booking.guest_phone || null,
      timestamp,
      timestamp
    );

    db.prepare(
      `UPDATE bookings SET payment_status = 'processing', updated_at = ?
       WHERE reference = ? AND payment_status != 'paid'`
    ).run(timestamp, booking.reference);

    recordEvent(booking.reference, 'payment_started', `${provider}:${method}`);
  })();

  const payment = getPayment(id)!;

  if (sandbox) {
    return {
      payment,
      sandbox: true,
      checkoutUrl: null,
      pendingProvider: false,
      message:
        'Test mode is active. No real money will be charged. Confirm the test payment to complete this booking.',
    };
  }

  try {
    if (method === 'card') {
      const link = await createCardCheckout({
        txRef: id,
        amount: booking.total,
        currency: booking.currency,
        customer: {
          email: booking.guest_email,
          name: booking.guest_name,
          phone: booking.guest_phone,
        },
        description: `${booking.item_name} · ${booking.reference}`,
        meta: { booking: booking.reference, payment: id },
      });

      updatePayment(id, { status: 'pending', checkout_url: link });
      return {
        payment: { ...payment, checkout_url: link },
        sandbox: false,
        checkoutUrl: link,
        pendingProvider: false,
        message: 'Redirecting you to the secure card checkout.',
      };
    }

    const network = method === 'mtn' ? 'MTN' : 'AIRTEL';
    const result = await chargeMobileMoney({
      txRef: id,
      amount: booking.total,
      currency: booking.currency,
      network,
      phone: phone || booking.guest_phone,
      email: booking.guest_email,
      name: booking.guest_name,
      meta: { booking: booking.reference, payment: id },
    });

    updatePayment(id, {
      status: 'processing',
      provider_reference: result.providerReference || null,
    });

    return {
      payment: {
        ...payment,
        status: 'processing',
        provider_reference: result.providerReference || null,
      },
      sandbox: false,
      checkoutUrl: result.redirect,
      pendingProvider: true,
      message:
        method === 'mtn'
          ? 'Approve the MTN MoMo prompt on your phone. This page updates once payment is confirmed.'
          : 'Approve the Airtel Money prompt on your phone. This page updates once payment is confirmed.',
    };
  } catch (error) {
    const message =
      error instanceof FlutterwaveError
        ? error.message
        : 'The payment provider could not start this payment.';
    updatePayment(id, { status: 'failed', failure_reason: message });
    markBookingPaymentFailed(booking.reference);
    throw new ApiError(502, message, 'payment_provider_error');
  }
}

export function confirmSandboxPayment(reference: string, paymentIdentifier: string) {
  if (!paymentsAreSandbox()) {
    throw new ApiError(403, 'Test payments are disabled in live mode.', 'sandbox_disabled');
  }

  const payment = getPayment(paymentIdentifier);
  if (!payment || payment.booking_reference !== reference.toUpperCase()) {
    throw new ApiError(404, 'Payment not found for this booking.', 'not_found');
  }
  if (payment.status === 'succeeded') {
    return getPayment(payment.id)!;
  }
  if (payment.status === 'cancelled' || payment.status === 'failed') {
    throw new ApiError(409, 'Start a new payment attempt.', 'payment_inactive');
  }
  if (payment.provider !== 'sandbox') {
    throw new ApiError(403, 'This payment is handled by the live provider.', 'wrong_provider');
  }

  db.transaction(() => {
    updatePayment(payment.id, { status: 'succeeded' });
    markBookingPaid(reference);
    recordEvent(reference, 'sandbox_payment_confirmed', payment.id);
  })();

  return getPayment(payment.id)!;
}

export function settleVerifiedTransaction(transaction: VerifiedTransaction) {
  const payment = getPayment(transaction.txRef);
  if (!payment) return { ok: false as const, reason: 'payment_not_found' };

  if (transaction.currency !== payment.currency) {
    updatePayment(payment.id, {
      status: 'failed',
      failure_reason: `Currency mismatch (${transaction.currency}).`,
    });
    markBookingPaymentFailed(payment.booking_reference);
    return { ok: false as const, reason: 'currency_mismatch' };
  }

  if (Math.round(transaction.amount) < payment.amount) {
    updatePayment(payment.id, {
      status: 'failed',
      failure_reason: `Amount mismatch (${transaction.amount} ${transaction.currency}).`,
    });
    markBookingPaymentFailed(payment.booking_reference);
    return { ok: false as const, reason: 'amount_mismatch' };
  }

  if (transaction.status !== 'successful') {
    updatePayment(payment.id, {
      status: transaction.status === 'failed' ? 'failed' : 'processing',
      provider_reference: String(transaction.id),
      failure_reason: transaction.status === 'failed' ? 'The provider declined the payment.' : null,
    });
    if (transaction.status === 'failed') markBookingPaymentFailed(payment.booking_reference);
    return { ok: false as const, reason: 'not_successful' };
  }

  db.transaction(() => {
    updatePayment(payment.id, {
      status: 'succeeded',
      provider_reference: String(transaction.id),
      failure_reason: null,
    });
    markBookingPaid(payment.booking_reference);
    recordEvent(
      payment.booking_reference,
      'payment_settled',
      `${payment.provider}:${transaction.id}`
    );
  })();

  return {
    ok: true as const,
    bookingReference: payment.booking_reference,
    paymentId: payment.id,
  };
}

export function latestPaymentForBooking(reference: string) {
  return db
    .prepare(
      `SELECT * FROM payments WHERE booking_reference = ? ORDER BY created_at DESC LIMIT 1`
    )
    .get(reference.toUpperCase()) as PaymentRow | undefined;
}

export function markPaymentStatus(id: string, status: PaymentStatus, reason?: string) {
  updatePayment(id, { status, failure_reason: reason ?? null });
}
