import { db, nowISO } from './db';
import {
  experiences as demoExperiences,
  regions,
  stays as demoStays,
  type Experience,
  type RegionSlug,
  type Stay,
  type StayType,
} from '@/lib/data';

export interface StayRow {
  slug: string;
  name: string;
  type: StayType;
  region: RegionSlug;
  location: string;
  price: number;
  rating: number;
  reviews: number;
  capacity: number;
  beds: string;
  images: string;
  tagline: string;
  description: string;
  amenities: string;
  nearby: string;
  host: string;
  host_note: string;
  badge: string | null;
  is_demo: number;
  sort_order: number;
  created_at: string;
  updated_at: string;
}

export interface ExperienceRow {
  slug: string;
  name: string;
  region: RegionSlug;
  duration: string;
  price: number;
  group_size: string;
  image: string;
  summary: string;
  description: string;
  includes: string;
  meeting_point: string;
  is_demo: number;
  sort_order: number;
  created_at: string;
  updated_at: string;
}

let schemaReady = false;

export function ensureContentSchema() {
  if (schemaReady) return;

  db.exec(`
    CREATE TABLE IF NOT EXISTS content_meta (
      key   TEXT PRIMARY KEY,
      value TEXT NOT NULL
    );

    CREATE TABLE IF NOT EXISTS stays (
      slug        TEXT PRIMARY KEY,
      name        TEXT NOT NULL,
      type        TEXT NOT NULL,
      region      TEXT NOT NULL,
      location    TEXT NOT NULL,
      price       INTEGER NOT NULL,
      rating      REAL NOT NULL DEFAULT 0,
      reviews     INTEGER NOT NULL DEFAULT 0,
      capacity    INTEGER NOT NULL DEFAULT 2,
      beds        TEXT NOT NULL DEFAULT '',
      images      TEXT NOT NULL DEFAULT '[]',
      tagline     TEXT NOT NULL DEFAULT '',
      description TEXT NOT NULL DEFAULT '[]',
      amenities   TEXT NOT NULL DEFAULT '[]',
      nearby      TEXT NOT NULL DEFAULT '[]',
      host        TEXT NOT NULL DEFAULT '',
      host_note   TEXT NOT NULL DEFAULT '',
      badge       TEXT,
      is_demo     INTEGER NOT NULL DEFAULT 0,
      sort_order  INTEGER NOT NULL DEFAULT 0,
      created_at  TEXT NOT NULL,
      updated_at  TEXT NOT NULL
    );

    CREATE TABLE IF NOT EXISTS experiences (
      slug          TEXT PRIMARY KEY,
      name          TEXT NOT NULL,
      region        TEXT NOT NULL,
      duration      TEXT NOT NULL,
      price         INTEGER NOT NULL,
      group_size    TEXT NOT NULL DEFAULT '',
      image         TEXT NOT NULL DEFAULT '',
      summary       TEXT NOT NULL DEFAULT '',
      description   TEXT NOT NULL DEFAULT '[]',
      includes      TEXT NOT NULL DEFAULT '[]',
      meeting_point TEXT NOT NULL DEFAULT '',
      is_demo       INTEGER NOT NULL DEFAULT 0,
      sort_order    INTEGER NOT NULL DEFAULT 0,
      created_at    TEXT NOT NULL,
      updated_at    TEXT NOT NULL
    );

    CREATE INDEX IF NOT EXISTS idx_stays_region ON stays(region);
    CREATE INDEX IF NOT EXISTS idx_experiences_region ON experiences(region);
  `);

  schemaReady = true;
  seedDemoContent();
}

function parseArray<T>(value: string, fallback: T[]): T[] {
  try {
    const parsed = JSON.parse(value);
    return Array.isArray(parsed) ? (parsed as T[]) : fallback;
  } catch {
    return fallback;
  }
}

export function mapStay(row: StayRow): Stay {
  return {
    slug: row.slug,
    name: row.name,
    type: row.type,
    region: row.region,
    location: row.location,
    price: row.price,
    rating: row.rating,
    reviews: row.reviews,
    capacity: row.capacity,
    beds: row.beds,
    images: parseArray<string>(row.images, []),
    tagline: row.tagline,
    description: parseArray<string>(row.description, []),
    amenities: parseArray<string>(row.amenities, []),
    nearby: parseArray<{ name: string; distance: string }>(row.nearby, []),
    host: row.host,
    hostNote: row.host_note,
    ...(row.badge ? { badge: row.badge } : {}),
  };
}

export function mapExperience(row: ExperienceRow): Experience {
  return {
    slug: row.slug,
    name: row.name,
    region: row.region,
    duration: row.duration,
    price: row.price,
    groupSize: row.group_size,
    image: row.image,
    summary: row.summary,
    description: parseArray<string>(row.description, []),
    includes: parseArray<string>(row.includes, []),
    meetingPoint: row.meeting_point,
  };
}

export function getStays(): Stay[] {
  ensureContentSchema();
  const rows = db
    .prepare('SELECT * FROM stays ORDER BY sort_order ASC, name ASC')
    .all() as StayRow[];
  return rows.map(mapStay);
}

export function getStayBySlug(slug: string): Stay | undefined {
  ensureContentSchema();
  const row = db.prepare('SELECT * FROM stays WHERE slug = ?').get(slug) as StayRow | undefined;
  return row ? mapStay(row) : undefined;
}

export function getExperiences(): Experience[] {
  ensureContentSchema();
  const rows = db
    .prepare('SELECT * FROM experiences ORDER BY sort_order ASC, name ASC')
    .all() as ExperienceRow[];
  return rows.map(mapExperience);
}

export function getExperienceBySlug(slug: string): Experience | undefined {
  ensureContentSchema();
  const row = db.prepare('SELECT * FROM experiences WHERE slug = ?').get(slug) as
    | ExperienceRow
    | undefined;
  return row ? mapExperience(row) : undefined;
}

export function getStaysInRegion(region: RegionSlug) {
  return getStays().filter((stay) => stay.region === region);
}

export function getExperiencesInRegion(region: RegionSlug) {
  return getExperiences().filter((experience) => experience.region === region);
}

export function getRegions() {
  return regions;
}

export function countContent() {
  ensureContentSchema();
  const stays = db.prepare('SELECT COUNT(*) as count FROM stays').get() as { count: number };
  const experiences = db
    .prepare('SELECT COUNT(*) as count FROM experiences')
    .get() as { count: number };
  const demoStays = db
    .prepare('SELECT COUNT(*) as count FROM stays WHERE is_demo = 1')
    .get() as { count: number };
  const demoExperiences = db
    .prepare('SELECT COUNT(*) as count FROM experiences WHERE is_demo = 1')
    .get() as { count: number };

  return {
    stays: stays.count,
    experiences: experiences.count,
    demoStays: demoStays.count,
    demoExperiences: demoExperiences.count,
  };
}

function setMeta(key: string, value: string) {
  db.prepare(
    'INSERT INTO content_meta (key, value) VALUES (?, ?) ON CONFLICT(key) DO UPDATE SET value = excluded.value'
  ).run(key, value);
}

function getMeta(key: string) {
  const row = db.prepare('SELECT value FROM content_meta WHERE key = ?').get(key) as
    | { value: string }
    | undefined;
  return row?.value;
}

const insertStay = db.prepare(`
  INSERT OR REPLACE INTO stays (
    slug, name, type, region, location, price, rating, reviews, capacity, beds,
    images, tagline, description, amenities, nearby, host, host_note, badge,
    is_demo, sort_order, created_at, updated_at
  ) VALUES (
    @slug, @name, @type, @region, @location, @price, @rating, @reviews, @capacity, @beds,
    @images, @tagline, @description, @amenities, @nearby, @host, @host_note, @badge,
    @is_demo, @sort_order, @created_at, @updated_at
  )
`);

const insertExperience = db.prepare(`
  INSERT OR REPLACE INTO experiences (
    slug, name, region, duration, price, group_size, image, summary, description,
    includes, meeting_point, is_demo, sort_order, created_at, updated_at
  ) VALUES (
    @slug, @name, @region, @duration, @price, @group_size, @image, @summary, @description,
    @includes, @meeting_point, @is_demo, @sort_order, @created_at, @updated_at
  )
`);

function seedStay(stay: Stay, index: number, timestamp: string) {
  insertStay.run({
    slug: stay.slug,
    name: stay.name,
    type: stay.type,
    region: stay.region,
    location: stay.location,
    price: stay.price,
    rating: stay.rating,
    reviews: stay.reviews,
    capacity: stay.capacity,
    beds: stay.beds,
    images: JSON.stringify(stay.images),
    tagline: stay.tagline,
    description: JSON.stringify(stay.description),
    amenities: JSON.stringify(stay.amenities),
    nearby: JSON.stringify(stay.nearby),
    host: stay.host,
    host_note: stay.hostNote,
    badge: stay.badge ?? null,
    is_demo: 1,
    sort_order: index,
    created_at: timestamp,
    updated_at: timestamp,
  });
}

function seedExperience(experience: Experience, index: number, timestamp: string) {
  insertExperience.run({
    slug: experience.slug,
    name: experience.name,
    region: experience.region,
    duration: experience.duration,
    price: experience.price,
    group_size: experience.groupSize,
    image: experience.image,
    summary: experience.summary,
    description: JSON.stringify(experience.description),
    includes: JSON.stringify(experience.includes),
    meeting_point: experience.meetingPoint,
    is_demo: 1,
    sort_order: index,
    created_at: timestamp,
    updated_at: timestamp,
  });
}

/**
 * The original site content is inserted once so the site works out of the box.
 * Every seeded row is flagged `is_demo = 1` and can be removed from the admin
 * panel without touching anything an admin has created.
 */
export function seedDemoContent(force = false) {
  ensureContentSchemaWithoutSeed();

  const marker = getMeta('demo_seeded');
  if (!force && marker) return { seeded: false, stays: 0, experiences: 0 };

  const existing = db.prepare('SELECT COUNT(*) as count FROM stays').get() as { count: number };
  const existingExperiences = db
    .prepare('SELECT COUNT(*) as count FROM experiences')
    .get() as { count: number };

  if (!force && (existing.count > 0 || existingExperiences.count > 0)) {
    setMeta('demo_seeded', '1');
    return { seeded: false, stays: 0, experiences: 0 };
  }

  const timestamp = nowISO();

  const run = db.transaction(() => {
    if (force) {
      db.prepare('DELETE FROM stays WHERE is_demo = 1').run();
      db.prepare('DELETE FROM experiences WHERE is_demo = 1').run();
    }

    demoStays.forEach((stay, index) => seedStay(stay, index, timestamp));
    demoExperiences.forEach((experience, index) => seedExperience(experience, index, timestamp));
    setMeta('demo_seeded', '1');
  });

  run();

  return { seeded: true, stays: demoStays.length, experiences: demoExperiences.length };
}

export function clearDemoContent() {
  ensureContentSchemaWithoutSeed();
  const run = db.transaction(() => {
    const stays = db.prepare('DELETE FROM stays WHERE is_demo = 1').run();
    const experiences = db.prepare('DELETE FROM experiences WHERE is_demo = 1').run();
    setMeta('demo_seeded', 'cleared');
    return { stays: stays.changes, experiences: experiences.changes };
  });
  return run();
}

// Used during seeding to avoid recursive calls through ensureContentSchema().
function ensureContentSchemaWithoutSeed() {
  if (schemaReady) return;
  db.exec(`
    CREATE TABLE IF NOT EXISTS content_meta (key TEXT PRIMARY KEY, value TEXT NOT NULL);
    CREATE TABLE IF NOT EXISTS stays (
      slug TEXT PRIMARY KEY, name TEXT NOT NULL, type TEXT NOT NULL, region TEXT NOT NULL,
      location TEXT NOT NULL, price INTEGER NOT NULL, rating REAL NOT NULL DEFAULT 0,
      reviews INTEGER NOT NULL DEFAULT 0, capacity INTEGER NOT NULL DEFAULT 2,
      beds TEXT NOT NULL DEFAULT '', images TEXT NOT NULL DEFAULT '[]',
      tagline TEXT NOT NULL DEFAULT '', description TEXT NOT NULL DEFAULT '[]',
      amenities TEXT NOT NULL DEFAULT '[]', nearby TEXT NOT NULL DEFAULT '[]',
      host TEXT NOT NULL DEFAULT '', host_note TEXT NOT NULL DEFAULT '', badge TEXT,
      is_demo INTEGER NOT NULL DEFAULT 0, sort_order INTEGER NOT NULL DEFAULT 0,
      created_at TEXT NOT NULL, updated_at TEXT NOT NULL
    );
    CREATE TABLE IF NOT EXISTS experiences (
      slug TEXT PRIMARY KEY, name TEXT NOT NULL, region TEXT NOT NULL,
      duration TEXT NOT NULL, price INTEGER NOT NULL, group_size TEXT NOT NULL DEFAULT '',
      image TEXT NOT NULL DEFAULT '', summary TEXT NOT NULL DEFAULT '',
      description TEXT NOT NULL DEFAULT '[]', includes TEXT NOT NULL DEFAULT '[]',
      meeting_point TEXT NOT NULL DEFAULT '', is_demo INTEGER NOT NULL DEFAULT 0,
      sort_order INTEGER NOT NULL DEFAULT 0, created_at TEXT NOT NULL, updated_at TEXT NOT NULL
    );
  `);
  schemaReady = true;
}

export interface StayInput {
  slug: string;
  name: string;
  type: StayType;
  region: RegionSlug;
  location: string;
  price: number;
  rating: number;
  reviews: number;
  capacity: number;
  beds: string;
  images: string[];
  tagline: string;
  description: string[];
  amenities: string[];
  nearby: { name: string; distance: string }[];
  host: string;
  hostNote: string;
  badge?: string | null;
}

export function saveStay(input: StayInput, slug?: string) {
  ensureContentSchema();
  const timestamp = nowISO();
  const targetSlug = slug ?? input.slug;

  if (slug && slug !== input.slug) {
    db.prepare('DELETE FROM stays WHERE slug = ?').run(slug);
  }

  const existing = db.prepare('SELECT sort_order FROM stays WHERE slug = ?').get(input.slug) as
    | { sort_order: number }
    | undefined;

  insertStay.run({
    slug: input.slug,
    name: input.name,
    type: input.type,
    region: input.region,
    location: input.location,
    price: input.price,
    rating: input.rating,
    reviews: input.reviews,
    capacity: input.capacity,
    beds: input.beds,
    images: JSON.stringify(input.images),
    tagline: input.tagline,
    description: JSON.stringify(input.description),
    amenities: JSON.stringify(input.amenities),
    nearby: JSON.stringify(input.nearby),
    host: input.host,
    host_note: input.hostNote,
    badge: input.badge ?? null,
    is_demo: 0,
    sort_order: existing?.sort_order ?? 1000,
    created_at: timestamp,
    updated_at: timestamp,
  });

  return getStayBySlug(input.slug);
}

export function deleteStay(slug: string) {
  ensureContentSchema();
  return db.prepare('DELETE FROM stays WHERE slug = ?').run(slug).changes > 0;
}

export interface ExperienceInput {
  slug: string;
  name: string;
  region: RegionSlug;
  duration: string;
  price: number;
  groupSize: string;
  image: string;
  summary: string;
  description: string[];
  includes: string[];
  meetingPoint: string;
}

export function saveExperience(input: ExperienceInput, slug?: string) {
  ensureContentSchema();
  const timestamp = nowISO();

  if (slug && slug !== input.slug) {
    db.prepare('DELETE FROM experiences WHERE slug = ?').run(slug);
  }

  const existing = db
    .prepare('SELECT sort_order FROM experiences WHERE slug = ?')
    .get(input.slug) as { sort_order: number } | undefined;

  insertExperience.run({
    slug: input.slug,
    name: input.name,
    region: input.region,
    duration: input.duration,
    price: input.price,
    group_size: input.groupSize,
    image: input.image,
    summary: input.summary,
    description: JSON.stringify(input.description),
    includes: JSON.stringify(input.includes),
    meeting_point: input.meetingPoint,
    is_demo: 0,
    sort_order: existing?.sort_order ?? 1000,
    created_at: timestamp,
    updated_at: timestamp,
  });

  return getExperienceBySlug(input.slug);
}

export function deleteExperience(slug: string) {
  ensureContentSchema();
  return db.prepare('DELETE FROM experiences WHERE slug = ?').run(slug).changes > 0;
}

export interface ListingRequestRecord {
  id: string;
  propertyName: string;
  propertyType: string;
  region: string;
  rooms: number;
  contactName: string;
  email: string;
  phone: string;
  notes: string;
  status: string;
  createdAt: string;
}

export function getListingRequests(): ListingRequestRecord[] {
  ensureContentSchema();
  const rows = db
    .prepare('SELECT * FROM listing_requests ORDER BY created_at DESC')
    .all() as Array<{
    id: string;
    property_name: string;
    property_type: string;
    region: string;
    rooms: number;
    contact_name: string;
    email: string;
    phone: string;
    notes: string;
    status: string;
    created_at: string;
  }>;

  return rows.map((row) => ({
    id: row.id,
    propertyName: row.property_name,
    propertyType: row.property_type,
    region: row.region,
    rooms: row.rooms,
    contactName: row.contact_name,
    email: row.email,
    phone: row.phone,
    notes: row.notes,
    status: row.status,
    createdAt: row.created_at,
  }));
}

export function updateListingRequestStatus(id: string, status: string) {
  ensureContentSchema();
  db.prepare('UPDATE listing_requests SET status = ? WHERE id = ?').run(status, id);
  return getListingRequests().find((request) => request.id === id);
}
