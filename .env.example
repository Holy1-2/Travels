# ── Database ──────────────────────────────────────────────────────────────────
# SQLite is created automatically in ./data. Override the location if needed.
# HAMUBERE_DATA_DIR=C:\path\to\data
# HAMUBERE_DATABASE_PATH=C:\path\to\hamubere.db

# ── Site ──────────────────────────────────────────────────────────────────────
# Used for metadata, sitemap-style links and payment redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Payments (Flutterwave) ────────────────────────────────────────────────────
# Leave the secret key blank and payments run in sandbox/test mode.
# Add a live or test key to charge cards, MTN MoMo and Airtel Money.
FLUTTERWAVE_SECRET_KEY=
# The secret hash configured under Settings → Webhooks in Flutterwave.
FLUTTERWAVE_WEBHOOK_HASH=
# Force test mode even when a key is present (true / false).
# PAYMENTS_SANDBOX=true

# Webhook URL to register with Flutterwave:
#   https://your-domain.com/api/webhooks/flutterwave
# Card redirect URL (registered automatically in the payment request):
#   https://your-domain.com/api/payments/callback

# ── Admin panel ───────────────────────────────────────────────────────────────
# Required in production. In local development the fallback is "hamubere-admin".
ADMIN_PASSWORD=change-me
# Long random string used to sign the 8-hour admin session cookie.
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret
